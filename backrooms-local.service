[Unit]
Description=Backrooms local model and bounded council daemon
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/backrooms
ExecStart=/usr/bin/python3 %h/backrooms/scripts/local_daemon.py --interval 900
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
