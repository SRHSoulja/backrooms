# Model providers. Put real keys in ~/.config/backrooms/env (mode 600), NOT in this repository.
# The router tries providers in BACKROOMS_PROVIDER_ORDER and uses the local llama-server last.
# MISTRAL_API_KEY=            # https://console.mistral.ai  (free Experiment tier; opt out of training in Settings > Privacy)
# GEMINI_API_KEY=             # https://aistudio.google.com
# CEREBRAS_API_KEY=           # https://cloud.cerebras.ai
# GROQ_API_KEY=               # https://console.groq.com
# OPENROUTER_API_KEY=         # https://openrouter.ai
# BACKROOMS_PROVIDER_ORDER=mistral,gemini,cerebras,groq,openrouter,custom,local
# BACKROOMS_MISTRAL_MODEL=ministral-14b-2512   # the Mistral family: mistral (14b) -> mistral-8b -> mistral-small, one key
# BACKROOMS_LOCAL_MODEL=fallback   # always | fallback | never
# BACKROOMS_CYCLE_SECONDS=1800
# Any OpenAI-compatible endpoint:
# BACKROOMS_LLM_BASE_URL=
# BACKROOMS_LLM_API_KEY=
# BACKROOMS_LLM_MODEL=
# Web search index for the residents' web family (free tier); without it the broker falls back to the engine and Wikipedia references.
# LANGSEARCH_API_KEY=
